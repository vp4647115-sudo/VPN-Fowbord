rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isProjectOwner() {
      return isSignedIn() && resource != null && resource.data.userId == request.auth.uid;
    }

    function isProjectCollaborator() {
      return isSignedIn() && resource != null && (
        resource.data.userId == request.auth.uid ||
        resource.data.isShared == true ||
        (resource.data.collaborators != null && request.auth.uid in resource.data.collaborators)
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // Projects collection: restrict reads strictly to project owners or authorized collaborators
    match /projects/{projectId} {
      allow read: if isProjectCollaborator();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isProjectOwner();
    }
  }
}
