# Gemini API Key for AI Studio & FlowBoard AI
GEMINI_API_KEY=

# Custom App Origin / Domain URL (e.g. https://flowboard.app)
APP_URL=

# Optional Client API Base URL (if frontend is deployed separately on static host like GitHub Pages or Vercel)
VITE_API_BASE_URL=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
